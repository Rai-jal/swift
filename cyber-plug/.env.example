# ── Copy this file to .env and fill in every value ───────────────────────────
# cp .env.example .env

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
# Generate API_KEY:   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Generate JWT_SECRET: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
JWT_SECRET=

# ── Your domain ───────────────────────────────────────────────────────────────
# Use the exact public URL users will visit (no trailing slash)
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://yourdomain.com

# ── Google OAuth ──────────────────────────────────────────────────────────────
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URI:  https://yourdomain.com/auth/google/callback
# 4. Add Authorized JavaScript origin: https://yourdomain.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_FROM=CyberPlug <noreply@yourdomain.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=

# ── LLM enrichment (optional) ────────────────────────────────────────────────
# Set LLM_PROVIDER to "claude" or "openai" to enable AI scan summaries
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# ── Billing — Paystack ────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PRO_AMOUNT=4900
PAYSTACK_ENTERPRISE_AMOUNT=0
PAYSTACK_CURRENCY=USD

# ── GitHub ────────────────────────────────────────────────────────────────────
# GitHub PAT — required only for scanning private repos without OAuth
GITHUB_TOKEN=
# GitHub OAuth App — enables "Connect GitHub" in Settings
# 1. Go to github.com → Settings → Developer settings → OAuth Apps → New OAuth App
# 2. Set "Authorization callback URL" to: https://yourdomain.com/auth/github/callback
# 3. Fill in the Client ID and Secret below
# 4. Set GITHUB_REDIRECT_URI to the exact callback URL you registered (avoids redirect_uri mismatch errors)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://yourdomain.com/auth/github/callback

# ── Scanner timeouts (seconds) ────────────────────────────────────────────────
TRIVY_TIMEOUT=300
SEMGREP_TIMEOUT=180
GITLEAKS_TIMEOUT=120

# ── Debug (set false in production) ──────────────────────────────────────────
DEBUG=false
